#!/bin/sh
# Relaunch a suspended reader so ReaderLockBooks is injected on its next launch.
kill_reader() {
  if command -v killall >/dev/null 2>&1; then
    killall -9 "$1" >/dev/null 2>&1 || true
  elif [ -x /var/jb/usr/bin/killall ]; then
    /var/jb/usr/bin/killall -9 "$1" >/dev/null 2>&1 || true
  fi
}
kill_reader Books
kill_reader "MapleRead SE"
kill_reader BMSEA
exit 0
